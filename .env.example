# Names only. Fill the values in your own .env (local) and in Vercel > Settings > Environment Variables (production).

# Supabase (server)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (browser, VITE_ prefix = public, never put a secret here)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
# Testing only: routes every email to this address. Must be empty in production.
EMAIL_OVERRIDE_TO=

# Public site address, used for links inside emails. Required in production.
APP_URL=

# Secret for the Vercel cron endpoint /api/cron/pending-reminder
CRON_SECRET=

# Only for scripts/run-remote-migration.mjs
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
